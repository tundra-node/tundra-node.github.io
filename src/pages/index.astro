---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 3);

const projects = await getCollection('projects');
const featured = projects.filter((p) => p.data.highlight).slice(0, 3);
---

<Base canonicalPath="/" activePath="/">
  <section class="hero">
    <h1>{SITE.title}</h1>
    <p>Privacy tools, homelab projects, cybersecurity notes, and open source software.</p>
  </section>

  <div class="nav-grid">
    <div class="nav-card">
      <a href="/about/">
        <h2>About</h2>
        <p>Who I am and what I'm into</p>
      </a>
    </div>
    <div class="nav-card">
      <a href="/projects/">
        <h2>Projects</h2>
        <p>Tools and configs I've built</p>
      </a>
    </div>
    <div class="nav-card">
      <a href="/blog/">
        <h2>Blog</h2>
        <p>Posts about I2P, Nix, and tech I'm working on</p>
      </a>
    </div>
    <div class="nav-card">
      <a href="/guides/">
        <h2>Guides</h2>
        <p>Step-by-step tutorials for I2P, self-hosting, and privacy tools</p>
      </a>
    </div>
  </div>

  {featured.length > 0 && (
    <section class="home-section">
      <h2>Featured projects</h2>
      <ul class="item-list">
        {featured.map((project) => (
          <li>
            <a href={`/projects/${project.id}/`}>{project.data.title}</a>
            <div class="desc">{project.data.description}</div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {latestPosts.length > 0 && (
    <section class="home-section">
      <h2>Latest posts</h2>
      <ul class="item-list">
        {latestPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <div class="meta">
              {post.data.pubDate.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              })}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>