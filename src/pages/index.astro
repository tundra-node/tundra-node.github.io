---
import Base from '../layouts/Base.astro';
import Desktop from '../components/Desktop.astro';
import Window from '../components/Window.astro';
import Terminal from '../components/Terminal.astro';
import { SITE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 3);

const projects = await getCollection('projects');
const featured = projects.filter((p) => p.data.highlight).slice(0, 3);
const allProjects = projects.slice(0, 6);
---

<Base canonicalPath="/" activePath="/" bare>
  <Desktop>
    <div slot="icons" class="icon-grid">
      <a class="desktop-icon" data-open="win-about" href="/about/">
        <span class="icon-glyph" aria-hidden="true">👤</span>
        <span class="icon-label">about</span>
      </a>
      <a class="desktop-icon" data-open="win-projects" href="/projects/">
        <span class="icon-glyph" aria-hidden="true">🗂</span>
        <span class="icon-label">projects</span>
      </a>
      <a class="desktop-icon" data-open="win-blog" href="/blog/">
        <span class="icon-glyph" aria-hidden="true">✎</span>
        <span class="icon-label">blog</span>
      </a>
      <a class="desktop-icon" data-open="win-guides" href="/guides/">
        <span class="icon-glyph" aria-hidden="true">➔</span>
        <span class="icon-label">guides</span>
      </a>
      <a class="desktop-icon" data-open="win-terminal" href="/">
        <span class="icon-glyph" aria-hidden="true">▤</span>
        <span class="icon-label">terminal</span>
      </a>
      <a class="desktop-icon" data-open="win-contact" href="mailto:press-onyx-posted@duck.com">
        <span class="icon-glyph" aria-hidden="true">✉</span>
        <span class="icon-label">contact</span>
      </a>
      <a class="desktop-icon" data-open="win-linkedin" href={SITE.linkedin}>
        <span class="icon-glyph" aria-hidden="true">in</span>
        <span class="icon-label">linkedin</span>
      </a>
      <a class="desktop-icon" data-open="win-rss" href="/rss.xml">
        <span class="icon-glyph" aria-hidden="true">◉</span>
        <span class="icon-label">rss</span>
      </a>
    </div>

    <Window id="win-terminal" title="terminal" open width="480px">
      <Terminal />
    </Window>

    <Window id="win-about" title="about" width="380px">
      <h2>{SITE.name}</h2>
      <p>
        high school senior studying network security. privacy-first, FOSS, create over consume.
      </p>
      <p>
        <a href="/about/">full about →</a>
      </p>
    </Window>

    <Window id="win-projects" title="projects" width="380px">
      {featured.length > 0 && (
        <ul class="win-list">
          {featured.map((project) => (
            <li>
              <a href={`/projects/${project.id}/`}>{project.data.title}</a>
              <div class="desc">{project.data.description}</div>
            </li>
          ))}
        </ul>
      )}
      <p>
        <a href="/projects/">all {allProjects.length} projects →</a>
      </p>
    </Window>

    <Window id="win-blog" title="blog" width="380px">
      {latestPosts.length > 0 && (
        <ul class="win-list">
          {latestPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <div class="desc">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </div>
            </li>
          ))}
        </ul>
      )}
      <p>
        <a href="/blog/">all posts →</a>
      </p>
    </Window>

    <Window id="win-guides" title="guides" width="380px">
      <p>step-by-step notes for i2p, self-hosting, and privacy tools.</p>
      <p>
        <a href="/guides/">all guides →</a>
      </p>
    </Window>

    <Window id="win-contact" title="contact" width="380px">
      <ul class="win-list">
        <li>
          <a href={`mailto:${SITE.email}`}>email</a>
          <div class="desc">{SITE.email}</div>
        </li>
        <li>
          <a href={SITE.github}>github</a>
          <div class="desc">@tundra-node</div>
        </li>
        <li>
          <a href={SITE.linkedin}>linkedin</a>
          <div class="desc">/in/eliaszeiner</div>
        </li>
        <li>
          <a href="/rss.xml">rss</a>
          <div class="desc">/rss.xml</div>
        </li>
      </ul>
    </Window>

    <Window id="win-linkedin" title="linkedin" width="380px">
      <p>
        <a href={SITE.linkedin}>{SITE.linkedin}</a>
      </p>
      <p class="desc">my first and last name, the professional way to reach me.</p>
    </Window>

    <Window id="win-rss" title="rss" width="380px">
      <p>
        subscribe: <a href="/rss.xml">/rss.xml</a>
      </p>
    </Window>
  </Desktop>

  <a class="skip-gimmick" href="#content">skip the gimmick ↓</a>

  <div id="content" class="home-content">
    <section class="home-section">
      <h1>{SITE.title}</h1>
      <p>{SITE.description}</p>
    </section>

    {featured.length > 0 && (
      <section class="home-section">
        <h2>featured projects</h2>
        <ul class="item-list">
          {featured.map((project) => (
            <li>
              <a href={`/projects/${project.id}/`}>{project.data.title}</a>
              <div class="desc">{project.data.description}</div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {latestPosts.length > 0 && (
      <section class="home-section">
        <h2>latest posts</h2>
        <ul class="item-list">
          {latestPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <div class="meta">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="nav-grid">
      <div class="nav-card">
        <a href="/about/">
          <h2>About</h2>
          <p>Who I am and what I'm into</p>
        </a>
      </div>
      <div class="nav-card">
        <a href="/projects/">
          <h2>Projects</h2>
          <p>Tools and configs I've built</p>
        </a>
      </div>
      <div class="nav-card">
        <a href="/blog/">
          <h2>Blog</h2>
          <p>Posts about I2P, Nix, and tech I'm working on</p>
        </a>
      </div>
      <div class="nav-card">
        <a href="/guides/">
          <h2>Guides</h2>
          <p>Step-by-step tutorials for I2P, self-hosting, and privacy tools</p>
        </a>
      </div>
    </div>
  </div>
</Base>