---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
---

<Base canonicalPath="/" activePath="/">
  <section class="hero">
    <h1>{SITE.title}</h1>
    <p>Privacy tools, homelab projects, cybersecurity notes, and open source software.</p>
  </section>

  <div class="nav-grid">
    <div class="nav-card">
      <a href="/about/">
        <h2>About</h2>
        <p>Who I am and what I'm into</p>
      </a>
    </div>
    <div class="nav-card">
      <a href="/projects/">
        <h2>Projects</h2>
        <p>Tools and configs I've built</p>
      </a>
    </div>
    <div class="nav-card">
      <a href="/blog/">
        <h2>Blog</h2>
        <p>Posts about I2P, Nix, and tech I'm working on</p>
      </a>
    </div>
    <div class="nav-card">
      <a href="/guides/">
        <h2>Guides</h2>
        <p>Step-by-step tutorials for I2P, self-hosting, and privacy tools</p>
      </a>
    </div>
  </div>
</Base>