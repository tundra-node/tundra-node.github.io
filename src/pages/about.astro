---
import Base from '../layouts/Base.astro';
import { SITE, OG_IMAGE } from '../consts';

const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Elias Zeiner',
  alternateName: 'tundra-node',
  url: SITE.url,
  image: OG_IMAGE,
  sameAs: [SITE.github],
  jobTitle: 'Cybersecurity student',
  knowsAbout: [
    'network security',
    'privacy',
    'homelab',
    'Nix',
    'I2P',
    'self-hosting',
    'open source',
  ],
});
---

<Base title="About" canonicalPath="/about/" activePath="/about/" ogType="profile" jsonLd={personJsonLd}>
  <h1>About</h1>

  <section class="about-section">
    <h2>who i am</h2>
    <p>
      I'm a high school senior studying network security at a local vocational tech school.
      I build privacy-focused tools, run a homelab, and write about what I learn.
    </p>
    <p>
      I care about doing things myself instead of consuming what everyone else ships.
      That means FOSS, self-hosted services, and tools that don't track you.
    </p>
  </section>

  <section class="about-section">
    <h2>stuff i do</h2>
    <ul>
      <li>cybersecurity student working toward a network security certificate</li>
      <li>Eagle Scout candidate</li>
      <li>FBLA. 5th at PA State 2026, NLC qualifier</li>
      <li>homelab. two servers, self-hosted media stack, WireGuard, Pi-hole</li>
      <li>open source. tools for I2P, privacy, and theater sound</li>
    </ul>
  </section>

  <section class="about-section">
    <h2>interests</h2>
    <ul>
      <li>cybersecurity and red teaming</li>
      <li>privacy and anti-surveillance</li>
      <li>jazz guitar and music</li>
      <li>retro computing</li>
      <li>fitness</li>
    </ul>
  </section>

  <section class="about-section">
    <h2>contact</h2>
    <ul>
      <li><a href={`mailto:${SITE.email}`}>email me</a></li>
      <li><a href={SITE.github}>github</a></li>
    </ul>
  </section>
</Base>