---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { OG_IMAGE } from '../../consts';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.pubDate.toISOString(),
  image: OG_IMAGE,
});
---

<Base
  title={guide.data.title}
  description={guide.data.description}
  canonicalPath={`/guides/${guide.id}/`}
  activePath="/guides/"
  ogType="article"
  jsonLd={articleJsonLd}
  windowTitle={guide.data.title}
>
  <article>
    <h1>{guide.data.title}</h1>
    <p class="date">
      {guide.data.pubDate.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      })}
    </p>
    {guide.data.tags.length > 0 && (
      <div class="tag-row">
        {guide.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}
    <Content />
  </article>
  <a class="back" href="/guides/">← Back</a>
</Base>