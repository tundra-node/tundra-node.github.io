<button class="toggle-btn" type="button" data-role="variant" aria-pressed="true" title="Toggle dark/light">
  <span class="toggle-label">theme</span>
</button>

<script>
  (function () {
    const KEY = 'tundra-site-theme';
    const variants = ['dark', 'light'];
    const store = {
      get(k) {
        try {
          return localStorage.getItem(k);
        } catch (e) {
          return null;
        }
      },
      set(k, v) {
        try {
          localStorage.setItem(k, v);
        } catch (e) {}
      },
    };

    function preferredVariant() {
      return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }

    function current() {
      return store.get(KEY) || document.documentElement.dataset.variant || preferredVariant();
    }

    function apply() {
      const variant = current();
      document.documentElement.dataset.variant = variant;
      const btn = document.querySelector('[data-role="variant"]');
      if (btn) btn.setAttribute('aria-pressed', String(variant === 'dark'));
    }

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-role="variant"]');
      if (!btn) return;
      const next = current() === 'dark' ? 'light' : 'dark';
      store.set(KEY, next);
      apply();
    });

    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
      if (!store.get(KEY)) apply();
    });

    apply();
  })();
</script>