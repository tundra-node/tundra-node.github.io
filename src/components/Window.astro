---
interface Props {
  id: string;
  title: string;
  icon?: string;
  open?: boolean;
  width?: string;
  x?: number;
  y?: number;
  closable?: boolean;
}
const { id, title, icon, open = false, width, x = 140, y = 48, closable = true } = Astro.props;
const style = `${width ? `width:${width};` : ''}left:${x}px;top:${y}px`;
---

<section class:list={['win', { 'win--content': !closable }]} id={id} style={style} hidden={!open} role="dialog" aria-label={title}>
  <header class="win-bar">
    <span class="win-title">
      {icon && <span class="win-icon" aria-hidden="true">{icon}</span>}
      {title}
    </span>
    {closable && (
      <button class="win-close" type="button" aria-label={`Close ${title}`}>×</button>
    )}
  </header>
  <div class="win-body">
    <slot />
  </div>
  <div class="win-resize" aria-hidden="true"></div>
</section>