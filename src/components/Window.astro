---
interface Props {
  id: string;
  title: string;
  icon?: string;
  open?: boolean;
  width?: string;
}
const { id, title, icon, open = false, width } = Astro.props;
const style = width ? `width:${width}` : undefined;
---

<section class="win" id={id} style={style} hidden={!open} role="dialog" aria-label={title}>
  <header class="win-bar">
    <span class="win-title">
      {icon && <span class="win-icon" aria-hidden="true">{icon}</span>}
      {title}
    </span>
    <button class="win-close" type="button" aria-label={`Close ${title}`}>×</button>
  </header>
  <div class="win-body">
    <slot />
  </div>
</section>