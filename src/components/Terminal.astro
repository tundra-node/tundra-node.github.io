---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const projects = await getCollection('projects');
const guides = await getCollection('guides');

const fsTree = {
  about: {
    'me.md': { title: 'about elias zeiner', link: '/about/' },
  },
  projects: Object.fromEntries(
    projects.map((p) => [p.id, { title: p.data.title, link: `/projects/${p.id}/` }]),
  ),
  blog: Object.fromEntries(
    posts.map((p) => [p.id, { title: p.data.title, link: `/blog/${p.id}/` }]),
  ),
  guides: Object.fromEntries(
    guides.map((g) => [g.id, { title: g.data.title, link: `/guides/${g.id}/` }]),
  ),
};
const fsJson = JSON.stringify(fsTree).replace(/</g, '\\u003c');
---

<script is:inline type="application/json" id="fs-data" set:html={fsJson}></script>

<div class="terminal" id="terminal">
  <div class="terminal-body" id="term-body" role="log" aria-live="polite"></div>
  <div class="terminal-line">
    <span class="terminal-prompt" id="term-prompt">guest@tundra-node:~$</span>
    <input
      class="terminal-input"
      id="term-input"
      type="text"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label="Terminal command"
    />
  </div>
</div>

<script is:inline>
  (function () {
    const body = document.getElementById('term-body');
    const input = document.getElementById('term-input');
    const promptEl = document.getElementById('term-prompt');
    if (!body || !input) return;

    const SITE = {
      name: 'Elias Zeiner',
      links: {
        about: '<a href="/about/">about</a>',
        projects: '<a href="/projects/">projects</a>',
        blog: '<a href="/blog/">blog</a>',
        guides: '<a href="/guides/">guides</a>',
        rss: '<a href="/rss.xml">rss</a>',
        fbla: '<a href="/fbla-cybersecurity-2026/">fbla study app</a>',
        linkedin: '<a href="https://www.linkedin.com/in/eliaszeiner">linkedin</a>',
        github: '<a href="https://github.com/tundra-node">github</a>',
      },
    };

    const RAW = JSON.parse(document.getElementById('fs-data').textContent);
    function file(title, link) {
      return { type: 'file', title, link };
    }
    function dir(children) {
      return { type: 'dir', children };
    }
    function build(raw, isRoot) {
      const out = {};
      for (const [name, val] of Object.entries(raw)) {
        out[name] = val.title ? file(val.title, val.link) : dir(build(val));
      }
      if (isRoot) out['rss.xml'] = file('rss feed', '/rss.xml');
      return out;
    }
    const ROOT = dir(build(RAW, true));
    let cwd = [];

    function nodeAt(segs) {
      let node = ROOT;
      for (const s of segs) {
        if (node.type !== 'dir' || !node.children[s]) return null;
        node = node.children[s];
      }
      return node;
    }

    function resolvePath(path) {
      const segs = path.startsWith('/') ? [] : [...cwd];
      for (const part of path.split('/')) {
        if (!part || part === '.') continue;
        if (part === '..') {
          if (segs.length) segs.pop();
          continue;
        }
        const node = nodeAt(segs);
        if (!node || node.type !== 'dir' || !node.children[part]) return null;
        segs.push(part);
      }
      return segs;
    }

    function displayPath(segs) {
      return '~' + (segs.length ? '/' + segs.join('/') : '');
    }

    function esc(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function entryHtml(name, node) {
      if (node.type === 'dir') return '<span class="terminal-dir">' + esc(name) + '/</span>';
      return '<span class="terminal-link">' + esc(name) + '</span>';
    }

    function ls(path) {
      const segs = path ? resolvePath(path) : [...cwd];
      if (!segs) return 'ls: cannot access \'' + esc(path) + '\': no such file or directory';
      const node = nodeAt(segs);
      if (node.type === 'file') return '<a href="' + node.link + '">' + esc(node.title) + '</a>';
      const names = Object.keys(node.children);
      if (!names.length) return '(empty)';
      return names.map((n) => entryHtml(n, node.children[n])).join('  ');
    }

    function cd(path) {
      if (!path) {
        cwd = [];
        return null;
      }
      const segs = resolvePath(path);
      if (!segs) return 'cd: no such directory: ' + esc(path);
      const node = nodeAt(segs);
      if (node.type === 'file') return 'cd: not a directory: ' + esc(path);
      cwd = segs;
      return null;
    }

    function cat(path) {
      if (!path) return 'cat: missing operand';
      const segs = resolvePath(path);
      if (!segs) return 'cat: ' + esc(path) + ': no such file';
      const node = nodeAt(segs);
      if (node.type === 'dir') return 'cat: ' + esc(path) + ': is a directory';
      return node.title + ' -> <a href="' + node.link + '">' + node.link + '</a>';
    }

    const COMMANDS = {
      help: () =>
        'available commands: help, whoami, about, projects, blog, guides, contact, linkedin, ' +
        'neofetch, ls [path], cd [dir], pwd, cat <file>, clear. try typing one, or press tab.',
      whoami: () => 'guest on tundra-node. the human behind it: ' + SITE.name + '.',
      about: () => 'who i am -> ' + SITE.links.about,
      projects: () => 'what i built -> ' + SITE.links.projects,
      blog: () => 'what i wrote -> ' + SITE.links.blog,
      guides: () => 'how-to notes -> ' + SITE.links.guides,
      rss: () => 'feed -> ' + SITE.links.rss,
      linkedin: () => 'linkedin -> ' + SITE.links.linkedin,
      github: () => 'github -> ' + SITE.links.github,
      contact: () =>
        'email: <a href="mailto:press-onyx-posted@duck.com">press-onyx-posted@duck.com</a>',
      fbla: () => 'fbla study app -> ' + SITE.links.fbla,
      pwd: () => displayPath(cwd),
      neofetch: () =>
        'tundra-node 7.2.3\nos: arch linux\nhost: home lab\nshell: this one\n' +
        'wm: none, we are all headless here\nuptime: yes',
      clear: () => {
        body.innerHTML = '';
        return null;
      },
      sudo: () => 'nice try. privilege escalation denied.',
      hack: () => 'scanning... 0 vulnerabilities found. better luck next time.',
      'rm -rf': () => 'refusing to delete the internet today.',
      whois: () =>
        'elias zeiner. senior. network security. pa, usa. first and last name only - no geolocation for you.',
      echo: (arg) => arg,
    };

    let history = [];
    let hIndex = -1;

    function print(text, cls) {
      const div = document.createElement('div');
      if (cls) div.className = cls;
      div.innerHTML = text;
      body.appendChild(div);
      body.scrollTop = body.scrollHeight;
    }

    function prompt() {
      return '<span class="terminal-prompt">guest@tundra-node:' + displayPath(cwd) + '$</span>';
    }

    function setPrompt() {
      promptEl.textContent = 'guest@tundra-node:' + displayPath(cwd) + '$';
    }

    function run(raw) {
      const line = document.createElement('div');
      line.className = 'terminal-line';
      line.innerHTML = prompt() + ' <span class="terminal-cmd">' + escapeHtml(raw) + '</span>';
      body.appendChild(line);

      const parts = raw.trim().replace(/\s+/g, ' ').split(' ');
      const cmd = parts[0];
      const arg = parts.slice(1).join(' ');
      if (raw.trim()) history.push(raw.trim());
      hIndex = history.length;

      if (!cmd) return;

      let out = 'command not found: ' + cmd;
      if (cmd in COMMANDS) {
        out = COMMANDS[cmd](arg);
      } else if (cmd === 'ls') {
        out = ls(arg);
      } else if (cmd === 'cd') {
        out = cd(arg);
        if (out === null) setPrompt();
      } else if (cmd === 'cat') {
        out = cat(arg);
      } else if (cmd === 'echo') {
        out = COMMANDS.echo(arg);
      }
      if (out !== null && out !== undefined) print(out, 'terminal-out');
      body.scrollTop = body.scrollHeight;
    }

    function escapeHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function complete() {
      const val = input.value.toLowerCase();
      if (!val) {
        input.value = 'help';
        return;
      }
      const cwdNode = nodeAt(cwd);
      const fsNames = cwdNode && cwdNode.type === 'dir' ? Object.keys(cwdNode.children) : [];
      const keys = Object.keys(COMMANDS)
        .concat(fsNames)
        .filter((k) => k.toLowerCase().startsWith(val));
      if (keys.length === 1) input.value = keys[0];
      else if (keys.length > 1) print(keys.join('  '), 'terminal-out');
    }

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        run(input.value);
        input.value = '';
      } else if (e.key === 'Tab') {
        e.preventDefault();
        complete();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (hIndex > 0) {
          hIndex--;
          input.value = history[hIndex] || '';
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (hIndex < history.length) {
          hIndex++;
          input.value = history[hIndex] || '';
        }
      }
    });

    print(
      'welcome to tundra-node. type <span class="terminal-cmd">help</span> to begin.',
      'terminal-out'
    );
    print(
      'you have a home directory. try <span class="terminal-cmd">ls</span> then ' +
        '<span class="terminal-cmd">cd projects</span>.',
      'terminal-out'
    );
    setPrompt();

    if (!window.matchMedia('(pointer: coarse)').matches) input.focus();
  })();
</script>