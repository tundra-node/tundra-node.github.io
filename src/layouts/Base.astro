---
import { SITE, OG_IMAGE, canonical } from '../consts';
import ThemeToggle from '../components/ThemeToggle.astro';
import Window from '../components/Window.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  jsonLd?: string;
  activePath?: string;
  noindex?: boolean;
  windowTitle?: string;
  windowIcon?: string;
  windowWidth?: string;
  windowX?: number;
  windowY?: number;
}

const {
  title,
  description = SITE.description,
  canonicalPath = '/',
  ogType = 'website',
  jsonLd,
  activePath = '/',
  noindex = false,
  windowTitle,
  windowIcon,
  windowWidth = '640px',
  windowX = 220,
  windowY = 56,
} = Astro.props;

const icons = [
  { id: 'win-terminal', href: '/', glyph: '▤', label: 'terminal' },
  { id: 'win-about', href: '/about/', glyph: '👤', label: 'about' },
  { id: 'win-projects', href: '/projects/', glyph: '🗂', label: 'projects' },
  { id: 'win-blog', href: '/blog/', glyph: '✎', label: 'blog' },
  { id: 'win-guides', href: '/guides/', glyph: '➔', label: 'guides' },
  { id: 'win-contact', href: `mailto:${SITE.email}`, glyph: '✉', label: 'contact' },
  { id: 'win-linkedin', href: SITE.linkedin, glyph: 'in', label: 'linkedin' },
  { id: 'win-rss', href: '/rss.xml', glyph: '◉', label: 'rss' },
];

function isCurrent(iconHref: string) {
  if (iconHref.startsWith('mailto:') || iconHref.startsWith('http')) return false;
  if (iconHref === '/') return activePath === '/';
  return activePath.startsWith(iconHref);
}

const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const pageDescription = description;
const pageUrl = canonical(canonicalPath);

const themeColors: Record<string, string> = {
  dark: '#2e3440',
  light: '#eceff4',
};

const themeColor = themeColors[SITE.defaultVariant] ?? '#2e3440';

const siteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  author: { '@type': 'Person', name: 'Elias Zeiner', url: SITE.github },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <meta name="referrer" content="no-referrer" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <script is:inline>
      (function () {
        var THEME = 'tundra-site-theme';
        var variants = ['dark', 'light'];
        var colors = {
          dark: '#2e3440',
          light: '#eceff4',
        };
        var read = function (k) {
          try {
            return localStorage.getItem(k);
          } catch (e) {
            return null;
          }
        };
        var variant = read(THEME) || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        if (variants.indexOf(variant) === -1) variant = 'dark';
        document.documentElement.dataset.variant = variant;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = colors[variant] || colors['dark'];
      })();
    </script>

    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={`${SITE.title} feed`} />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <script type="application/ld+json" set:html={siteJsonLd} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="desktop" id="desktop">
      <canvas class="desktop-wall" id="desktop-wall" aria-hidden="true"></canvas>

      <div class="desktop-icons" id="desktop-icons">
        <div class="icon-grid">
          {icons.map((icon) => (
            <a
              class="desktop-icon"
              data-open={icon.id}
              href={icon.href}
              aria-current={isCurrent(icon.href) ? 'page' : undefined}
            >
              <span class="icon-glyph" aria-hidden="true">{icon.glyph}</span>
              <span class="icon-label">{icon.label}</span>
            </a>
          ))}
        </div>
      </div>

      <main class="desktop-windows" id="main">
        {windowTitle ? (
          <Window
            id="win-content"
            title={windowTitle}
            icon={windowIcon}
            open
            width={windowWidth}
            x={windowX}
            y={windowY}
            closable={false}
          >
            <slot />
          </Window>
        ) : (
          <slot />
        )}
      </main>

      <div class="taskbar" id="taskbar">
        <a class="taskbar-brand" href="/">{SITE.title}</a>
        <span class="taskbar-right">
          <span class="taskbar-clock" id="taskbar-clock">--:--</span>
          <ThemeToggle />
        </span>
      </div>
    </div>

    <script>
      (function () {
        const desk = document.getElementById('desktop');
        const wall = document.getElementById('desktop-wall');
        const clock = document.getElementById('taskbar-clock');
        if (!desk || !wall) return;

        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ---------- wallpaper canvas: network + snow ----------
        const ctx = wall.getContext('2d');
        const nodes = [
          { x: 0.12, y: 0.18, label: 'home' },
          { x: 0.32, y: 0.12, label: 'media' },
          { x: 0.52, y: 0.24, label: 'i2p' },
          { x: 0.72, y: 0.14, label: 'nix' },
          { x: 0.26, y: 0.55, label: 'wg' },
          { x: 0.64, y: 0.5, label: 'dns' },
        ];
        const pos = nodes.map((n) => ({ x: n.x, y: n.y }));
        const vel = nodes.map(() => ({
          x: (Math.random() - 0.5) * 0.0006,
          y: (Math.random() - 0.5) * 0.0006,
        }));
        const mouse = { x: -1, y: -1 };
        const links = [
          [0, 1],
          [1, 2],
          [2, 3],
          [0, 3],
          [0, 4],
          [4, 5],
          [2, 5],
          [1, 5],
        ];
        const snow = [];
        const N = reduced ? 0 : 34;
        for (let i = 0; i < N; i++) {
          snow.push({
            x: Math.random(),
            y: Math.random(),
            r: 0.6 + Math.random() * 1.4,
            v: 0.0004 + Math.random() * 0.001,
            drift: (Math.random() - 0.5) * 0.0008,
          });
        }

        let deskRect = desk.getBoundingClientRect();
        desk.addEventListener('mousemove', (e) => {
          mouse.x = (e.clientX - deskRect.left) / deskRect.width;
          mouse.y = (e.clientY - deskRect.top) / deskRect.height;
        });
        desk.addEventListener('mouseleave', () => {
          mouse.x = -1;
          mouse.y = -1;
        });

        function size() {
          deskRect = desk.getBoundingClientRect();
          const w = (wall.width = desk.clientWidth * window.devicePixelRatio);
          const h = (wall.height = desk.clientHeight * window.devicePixelRatio);
          wall.style.width = desk.clientWidth + 'px';
          wall.style.height = desk.clientHeight + 'px';
          return { w, h };
        }

        let dims = size();
        window.addEventListener('resize', () => {
          dims = size();
        });

        let accent = '#88c0d0';
        let snowColor = '#e5e9f0';
        function readTheme() {
          const cs = getComputedStyle(document.documentElement);
          accent = cs.getPropertyValue('--accent').trim() || accent;
          snowColor = cs.getPropertyValue('--text-dim').trim() || snowColor;
        }
        readTheme();
        new MutationObserver(readTheme).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-variant'],
        });

        function segDist(px, py, ax, ay, bx, by) {
          const dx = bx - ax;
          const dy = by - ay;
          const l2 = dx * dx + dy * dy;
          if (l2 === 0) return Math.hypot(px - ax, py - ay);
          let t = ((px - ax) * dx + (py - ay) * dy) / l2;
          t = Math.max(0, Math.min(1, t));
          return Math.hypot(px - (ax + t * dx), py - (ay + t * dy));
        }

        function draw() {
          const { w, h } = dims;
          ctx.clearRect(0, 0, w, h);

          if (!reduced) {
            for (let i = 0; i < pos.length; i++) {
              vel[i].x += (Math.random() - 0.5) * 0.00004;
              vel[i].y += (Math.random() - 0.5) * 0.00004;
              pos[i].x += vel[i].x;
              pos[i].y += vel[i].y;
              if (pos[i].x < 0.04 || pos[i].x > 0.96) vel[i].x *= -1;
              if (pos[i].y < 0.04 || pos[i].y > 0.96) vel[i].y *= -1;
              if (mouse.x >= 0) {
                const dx = pos[i].x - mouse.x;
                const dy = pos[i].y - mouse.y;
                const d = Math.hypot(dx, dy);
                if (d < 0.22 && d > 0) {
                  const f = (0.22 - d) / 0.22;
                  vel[i].x += (dx / d) * f * 0.004;
                  vel[i].y += (dy / d) * f * 0.004;
                }
              }
              vel[i].x *= 0.995;
              vel[i].y *= 0.995;
            }
          }

          for (const [a, b] of links) {
            let alpha = 0.3;
            if (mouse.x >= 0) {
              const d = segDist(mouse.x, mouse.y, pos[a].x, pos[a].y, pos[b].x, pos[b].y);
              if (d < 0.18) alpha = Math.min(1, 0.3 + ((0.18 - d) / 0.18) * 0.7);
            }
            ctx.globalAlpha = alpha;
            ctx.lineWidth = alpha > 0.5 ? 2 : 1;
            ctx.strokeStyle = accent;
            ctx.beginPath();
            ctx.moveTo(pos[a].x * w, pos[a].y * h);
            ctx.lineTo(pos[b].x * w, pos[b].y * h);
            ctx.stroke();
          }

          ctx.globalAlpha = 1;
          ctx.fillStyle = accent;
          for (const n of pos) {
            let r = 3;
            if (mouse.x >= 0 && Math.hypot(n.x - mouse.x, n.y - mouse.y) < 0.12) r = 5;
            ctx.beginPath();
            ctx.arc(n.x * w, n.y * h, r, 0, Math.PI * 2);
            ctx.fill();
          }

          if (!reduced) {
            ctx.fillStyle = snowColor;
            for (const p of snow) {
              p.y += p.v;
              p.x += p.drift;
              if (p.y > 1) {
                p.y = 0;
                p.x = Math.random();
              }
              if (p.x < 0) p.x = 1;
              if (p.x > 1) p.x = 0;
              ctx.globalAlpha = 0.7;
              ctx.beginPath();
              ctx.arc(p.x * w, p.y * h, p.r, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.globalAlpha = 1;
          }

          if (!reduced) requestAnimationFrame(draw);
        }
        requestAnimationFrame(draw);

        // ---------- clock ----------
        function tick() {
          if (!clock) return;
          const d = new Date();
          const hh = String(d.getHours()).padStart(2, '0');
          const mm = String(d.getMinutes()).padStart(2, '0');
          clock.textContent = `${hh}:${mm}`;
        }
        tick();
        setInterval(tick, 30000);

        // ---------- window manager ----------
        let z = 10;
        const TASKBAR = 34;

        function focusWin(win) {
          z++;
          win.style.zIndex = String(z);
          win.classList.add('win--active');
          document.querySelectorAll('.win').forEach((w) => {
            if (w !== win) w.classList.remove('win--active');
          });
        }

        function closeWindow(win) {
          win.hidden = true;
          win.classList.remove('win--active');
        }

        // icons: open the window if it exists on this page, else navigate
        document.addEventListener('click', (e) => {
          const icon = e.target.closest('[data-open]');
          if (!icon) return;
          const id = icon.getAttribute('data-open');
          const win = document.getElementById(id);
          if (!win) return;
          e.preventDefault();
          if (win.hidden) {
            win.hidden = false;
            focusWin(win);
            win.focus({ preventScroll: true });
          } else {
            closeWindow(win);
          }
        });

        // close buttons
        document.addEventListener('click', (e) => {
          const btn = e.target.closest('.win-close');
          if (!btn) return;
          const win = btn.closest('.win');
          if (win) closeWindow(win);
        });

        // bring to front on mousedown
        document.addEventListener('mousedown', (e) => {
          const win = e.target.closest('.win');
          if (win && !win.hidden) focusWin(win);
        });

        // drag windows by their title bar
        document.addEventListener('mousedown', (e) => {
          const bar = e.target.closest('.win-bar');
          if (!bar) return;
          const win = bar.closest('.win');
          if (!win || win.hidden) return;

          const rect = win.getBoundingClientRect();
          const offX = e.clientX - rect.left;
          const offY = e.clientY - rect.top;

          function move(ev) {
            let x = ev.clientX - offX - deskRect.left;
            let y = ev.clientY - offY - deskRect.top;
            x = Math.max(0, Math.min(x, deskRect.width - win.offsetWidth));
            y = Math.max(0, Math.min(y, deskRect.height - TASKBAR - 4));
            win.style.left = x + 'px';
            win.style.top = y + 'px';
          }

          function up() {
            document.removeEventListener('mousemove', move);
            document.removeEventListener('mouseup', up);
          }

          document.addEventListener('mousemove', move);
          document.addEventListener('mouseup', up);
        });

        // resize windows by the corner handle
        document.addEventListener('mousedown', (e) => {
          const handle = e.target.closest('.win-resize');
          if (!handle) return;
          const win = handle.closest('.win');
          if (!win || win.hidden) return;
          e.preventDefault();

          const startX = e.clientX;
          const startY = e.clientY;
          const startW = win.offsetWidth;
          const startH = win.offsetHeight;
          const minW = 280;
          const minH = 140;

          function move(ev) {
            const maxW = deskRect.width - win.offsetLeft;
            const maxH = deskRect.height - win.offsetTop - TASKBAR - 4;
            const w = Math.max(minW, Math.min(startW + (ev.clientX - startX), maxW));
            const h = Math.max(minH, Math.min(startH + (ev.clientY - startY), maxH));
            win.style.width = w + 'px';
            win.style.height = h + 'px';
          }

          function up() {
            document.removeEventListener('mousemove', move);
            document.removeEventListener('mouseup', up);
          }

          document.addEventListener('mousemove', move);
          document.addEventListener('mouseup', up);
        });

        // keyboard: escape closes active window
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            const active = document.querySelector('.win--active');
            if (active && !active.hidden && active.querySelector('.win-close')) {
              closeWindow(active);
            }
          }
        });
      })();
    </script>
  </body>
</html>